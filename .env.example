# Base URL for the Order Service API
API_BASE_URL=http://localhost:8080

# Optional Catalog Service API base URL for API-046 through API-049
# CATALOG_API_BASE_URL=http://localhost:8081

# Seed IDs used by the API reference matrix
API_ACTIVE_PRODUCT_ID=P-100
API_SECOND_PRODUCT_ID=P-200
API_INACTIVE_PRODUCT_ID=P-OFF
API_NO_PRICE_PRODUCT_ID=P-NOPR
API_MISSING_PRODUCT_ID=P-404
API_ACTIVE_PRODUCT_PRICE=50
API_SECOND_PRODUCT_PRICE=1200

# Optional configured-rule and bulk-size fixtures
# API_NO_DISCOUNT_PRODUCT_ID=P-NODISC
# API_SPECIAL_DISCOUNT_PRODUCT_ID=P-SPECIAL
# API_ROUNDING_PRODUCT_ID=P-ROUND
# API_ROUNDING_EXPECTED_DISCOUNT=0.01
# API_ROUNDING_QUANTITY=1
# API_BULK_PRODUCT_IDS=P-001,P-002,...

# Set only while the catalog service is intentionally down, timing out, or restored
# API_CATALOG_FAULT_MODE=down|timeout|recovered

# Set this to enable dashboard browser tests
# APP_BASE_URL=http://localhost:4200
